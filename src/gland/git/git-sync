#!/usr/bin/env bash
#
# git sync: bring the branch you're on up to date with the upstream primary branch, before you push.
#
#   1. fetch <remote>/<primary>            (remote: upstream, else origin; primary: dev.local, main or master)
#   2. fork's origin/<primary> := upstream  (fast-forward only, never forced; skipped if the fork has its own commits)
#   3. local <primary> := upstream          (fast-forward only; left alone if it has unpushed commits, or if it's
#                                            checked out in another worktree)
#   4. rebase the current branch onto <remote>/<primary>, never onto the local primary
#      (--autostash: a dirty tree is fine; --rebase-merges: merge commits are kept)
#
# It's the write half of the pre-push hook next to it, which only checks and tells you to run this. Works in any
# worktree. Overrides: GIT_PRIMARY_BRANCH, GIT_PRIMARY_REMOTE. Why it's split this way: README.md here.
#
set -euo pipefail

log() { echo "[git sync] $*" >&2; }
die() { log "ERROR: $1"; exit "${2:-1}"; }

git rev-parse --git-dir >/dev/null 2>&1 || die "not in a git repository"

primary="${GIT_PRIMARY_BRANCH:-}"
if [[ -z "$primary" ]]; then
  for b in dev.local main master; do
    if git show-ref --verify --quiet "refs/heads/$b"; then primary="$b"; break; fi
  done
fi
[[ -n "$primary" ]] || die "no primary branch (dev.local/main/master); set GIT_PRIMARY_BRANCH"

remote="${GIT_PRIMARY_REMOTE:-}"
if [[ -z "$remote" ]]; then
  if git remote get-url upstream >/dev/null 2>&1; then remote=upstream
  elif git remote get-url origin >/dev/null 2>&1; then remote=origin
  else die "no 'upstream' or 'origin' remote"; fi
fi
base="refs/remotes/$remote/$primary"

if [[ -d "$(git rev-parse --git-path rebase-merge)" || -d "$(git rev-parse --git-path rebase-apply)" ]]; then
  die "a rebase is in progress here: finish it (git rebase --continue) or abort it (git rebase --abort) first"
fi

log "fetching $remote/$primary"
git fetch --quiet "$remote" "$primary" || die "git fetch $remote $primary failed (network or auth)"
up_sha="$(git rev-parse "$base")"

# 2. the fork's primary (origin), fast-forward only
if [[ "$remote" != origin ]] && git remote get-url origin >/dev/null 2>&1; then
  git fetch --quiet origin "$primary" 2>/dev/null || true
  fork="refs/remotes/origin/$primary"
  if ! git show-ref --verify --quiet "$fork"; then
    log "origin has no $primary; not syncing the fork"
  elif [[ "$(git rev-parse "$fork")" == "$up_sha" ]]; then
    :
  elif git merge-base --is-ancestor "$fork" "$up_sha"; then
    log "fast-forwarding origin/$primary to $remote/$primary"
    git push --quiet --no-verify origin "$up_sha:refs/heads/$primary" || log "could not update origin/$primary (left as is)"
  else
    log "origin/$primary has commits $remote/$primary doesn't; left as is (not forcing)"
  fi
fi

# 3. the local primary, fast-forward only, wherever it is checked out
local_sha="$(git rev-parse "refs/heads/$primary")"
here="$(git rev-parse --show-toplevel)"
checked_out_at=""
while IFS= read -r line; do
  case "$line" in
    "worktree "*) wt="${line#worktree }" ;;
    "branch refs/heads/$primary") checked_out_at="$wt" ;;
  esac
done < <(git worktree list --porcelain)

if [[ "$local_sha" == "$up_sha" ]]; then
  :
elif ! git merge-base --is-ancestor "$local_sha" "$up_sha"; then
  ahead="$(git rev-list --count "$up_sha..$local_sha")"
  log "local $primary has $ahead commit(s) not on $remote/$primary; left as is (your branch is rebased onto $remote/$primary, so they don't leak into it)"
elif [[ -z "$checked_out_at" ]]; then
  git update-ref "refs/heads/$primary" "$up_sha" "$local_sha"
  log "local $primary fast-forwarded to $remote/$primary"
elif [[ "$checked_out_at" == "$here" ]]; then
  git merge --quiet --ff-only "$up_sha" && log "local $primary fast-forwarded to $remote/$primary"
else
  log "local $primary is behind but checked out in $checked_out_at; there: git merge --ff-only $remote/$primary"
fi

# 4. the current branch
branch="$(git symbolic-ref --short -q HEAD || true)"
if [[ -z "$branch" ]]; then
  log "detached HEAD: nothing to rebase"; exit 0
fi
if [[ "$branch" == "$primary" ]]; then
  log "on $primary: done"; exit 0
fi
if git merge-base --is-ancestor "$up_sha" HEAD; then
  log "$branch already contains $remote/$primary: nothing to rebase"
else
  log "rebasing $branch onto $remote/$primary"
  if ! git rebase --quiet --autostash --rebase-merges "$up_sha"; then
    log "rebase stopped on a conflict: fix the files, git add them, git rebase --continue (or git rebase --abort)"
    exit 1
  fi
fi

# What the push needs: a force only when the branch was pushed before and has been rewritten since.
upstream_of_branch="$(git rev-parse --abbrev-ref --symbolic-full-name "@{u}" 2>/dev/null || true)"
pushed="refs/remotes/origin/$branch"
if git show-ref --verify --quiet "$pushed" && ! git merge-base --is-ancestor "$pushed" HEAD; then
  log "done. $branch was rewritten since it was pushed: git push --force-with-lease origin $branch"
elif [[ -z "$upstream_of_branch" ]]; then
  log "done. git push -u origin $branch"
else
  log "done. git push"
fi
