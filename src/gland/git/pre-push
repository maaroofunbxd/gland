#!/usr/bin/env bash
#
# Global pre-push hook (core.hooksPath): a check, nothing else. A branch you push must contain the latest
# upstream primary (dev.local, main or master on `upstream`, else `origin`). If it doesn't, the push stops and
# you run `git sync` (git-sync next to this file), which syncs the primaries and rebases your branch, then push again.
#
# It changes nothing: a pre-push hook can't change what git sends (git picked the commits before the hook runs).
# README.md here says why, and how it's installed.
#
# Not checked: pushes of the primary itself, tags, deletes. Overrides: GIT_PRIMARY_BRANCH, GIT_PRIMARY_REMOTE.
# Trace: GIT_PUSH_HOOK_VERBOSE=1 git push ...
#
set -uo pipefail

vlog() { [[ -n "${GIT_PUSH_HOOK_VERBOSE:-}" ]] && echo "[pre-push:verbose] $*" >&2; return 0; }
log() { echo "[pre-push] $*" >&2; }

if [[ "${GIT_PUSH_HOOK_SKIP:-}" == "1" ]]; then
  log "GIT_PUSH_HOOK_SKIP=1: not checking"
  exit 0
fi

primary="${GIT_PRIMARY_BRANCH:-}"
if [[ -z "$primary" ]]; then
  for b in dev.local main master; do
    if git show-ref --verify --quiet "refs/heads/$b"; then primary="$b"; break; fi
  done
fi
[[ -n "$primary" ]] || { vlog "no primary branch: not checking"; exit 0; }

remote="${GIT_PRIMARY_REMOTE:-}"
if [[ -z "$remote" ]]; then
  if git remote get-url upstream >/dev/null 2>&1; then remote=upstream
  elif git remote get-url origin >/dev/null 2>&1; then remote=origin
  else vlog "no upstream/origin remote: not checking"; exit 0; fi
fi
base="refs/remotes/$remote/$primary"
zero="0000000000000000000000000000000000000000"

fetched=""
behind=()
missing=""
while read -r local_ref local_sha remote_ref _remote_sha; do
  vlog "$local_ref $local_sha -> $remote_ref"
  [[ "$local_sha" == "$zero" ]] && continue                 # a delete
  [[ "$remote_ref" == refs/heads/* ]] || continue           # tags, notes
  [[ "$remote_ref" == "refs/heads/$primary" ]] && continue  # the primary itself
  if [[ -z "$fetched" ]]; then
    fetched=1
    if ! git fetch --quiet "$remote" "$primary" 2>/dev/null; then
      log "could not fetch $remote/$primary (network?); checking against the last fetched one"
    fi
    git show-ref --verify --quiet "$base" || { log "no $remote/$primary to check against; not checking"; exit 0; }
  fi
  if ! git merge-base --is-ancestor "$base" "$local_sha"; then
    behind+=("${local_ref#refs/heads/}")
    [[ -n "$missing" ]] || missing="$(git rev-list --count "$local_sha..$base")"
  fi
done

if (( ${#behind[@]} )); then
  log "${behind[*]} is behind $remote/$primary ($missing commit(s) missing). Nothing was pushed."
  log "Run: git sync   (rebases the branch you're on onto $remote/$primary; syncs origin/$primary and local $primary, fast-forward only)"
  log "then push again. git sync prints the push command (a --force-with-lease one if the branch was pushed before)."
  exit 1
fi
vlog "up to date with $remote/$primary"
exit 0
